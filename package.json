{
  "name": "AlePDV",
  "version": "1.0.0",
  "description": "PDV Alecrim Inteligente - Sistema de Ponto de Venda",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n MAIN,RENDERER,ELECTRON -c green,blue,magenta \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.electron.json --watch --sourcemap",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "package": "tsc -p tsconfig.electron.json && vite build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "electron-store": "^8.2.0",
    "express": "^4.19.0",
    "mysql2": "^3.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.alecriminteligente.pdv",
    "productName": "Alecrim PDV",
    "files": ["dist-electron/**/*", "dist/renderer/**/*", "resources/**/*"],
    "directories": { "output": "release" },
    "win": { "target": "nsis", "icon": "resources/icon.png" }
  }
}